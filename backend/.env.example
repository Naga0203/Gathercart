# GatherCart Backend Environment Configuration (Supabase PostgreSQL)

# Server Port (8081 avoiding collision with existing httpd on 8080)
SERVER_PORT=8081

# Supabase Project URL & API Key
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Supabase PostgreSQL Database Connection
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example Direct: jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
# Example Pooler: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password

# JPA / Hibernate configuration
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
