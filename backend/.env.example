# GatherCart Backend Environment Configuration (Supabase PostgreSQL)

# Server Port (8081 matches frontend VITE_API_BASE_URL)
SERVER_PORT=8081

# Supabase Project URL & API Key (optional; used if integrating Supabase REST/Storage)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Supabase PostgreSQL Database Connection
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example Direct: jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
# Example Pooler: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DATABASE_URL=jdbc:postgresql://db.your-project-id.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_DRIVER=org.postgresql.Driver

# JPA / Hibernate configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration (minimum 32 chars for HS256)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
